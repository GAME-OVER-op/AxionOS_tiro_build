<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.REAL_GET_TASKS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/device_settings_app_name"
        android:directBootAware="true"
        android:persistent="true"
        android:theme="@style/Theme.SubSettingsBase.Expressive">

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".TileActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <activity
            android:name=".nubia.NubiaActivity"
            android:label="@string/nubia_title"
            android:exported="false">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_nubia"/>
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/nubia_summary" />
        </activity>

        <activity
            android:name=".fan.FanActivity"
            android:label="@string/fan_control_title"
            android:exported="true">
            <intent-filter>
                <action android:name="org.lineageos.settings.FAN_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".trigger.TriggerActivity"
            android:label="@string/trigger_buttons_title"
            android:exported="true">
            <intent-filter>
                <action android:name="org.lineageos.settings.TRIGGER_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".trigger.TriggerAppsActivity"
            android:exported="false" />

        <activity
            android:name=".trigger.TriggerAppActivity"
            android:exported="false" />

        <activity
            android:name=".trigger.TriggerCalibrationActivity"
            android:configChanges="density|fontScale|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:screenOrientation="behind"
            android:theme="@style/Theme.NubiaParts.Calibration" />

        <activity
            android:name=".lighting.LightingActivity"
            android:label="@string/lighting_title"
            android:exported="true">
            <intent-filter>
                <action android:name="org.lineageos.settings.LIGHTING_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".hbm.HbmActivity"
            android:label="@string/hbm_title"
            android:exported="true">
            <intent-filter>
                <action android:name="org.lineageos.settings.HBM_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.HardwareControlService"
            android:directBootAware="true"
            android:exported="false" />

        <service
            android:name=".service.NubiaNotificationListener"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting|silent" />
        </service>

        <service
            android:name=".fan.FanTileService"
            android:exported="true"
            android:label="@string/fan_control_title"
            android:icon="@drawable/ic_fan"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".trigger.TriggerTileService"
            android:exported="true"
            android:label="@string/trigger_buttons_title"
            android:icon="@drawable/ic_triggers"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".hbm.HbmTileService"
            android:exported="true"
            android:label="@string/hbm_tile_title"
            android:icon="@drawable/ic_hbm"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
