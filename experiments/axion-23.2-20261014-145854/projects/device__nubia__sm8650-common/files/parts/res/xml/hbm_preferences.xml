<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <ListPreference
        android:key="hbm_mode"
        android:entries="@array/hbm_mode_entries"
        android:entryValues="@array/hbm_mode_values"
        android:title="@string/hbm_mode_title" />

    <com.android.settingslib.widget.SliderPreference
        android:key="auto_hbm_lux_on"
        android:title="@string/hbm_lux_on_title"
        android:summary="@string/hbm_lux_on_summary" />

    <com.android.settingslib.widget.SliderPreference
        android:key="auto_hbm_lux_off"
        android:title="@string/hbm_lux_off_title"
        android:summary="@string/hbm_lux_off_summary" />

    <Preference
        android:key="hbm_forced_warning"
        android:selectable="false"
        android:summary="@string/hbm_forced_warning" />
</PreferenceScreen>
