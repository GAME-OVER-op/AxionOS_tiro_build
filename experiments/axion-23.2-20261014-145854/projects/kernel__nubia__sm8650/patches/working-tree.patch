diff --git a/drivers/thermal/thermal_helpers.c b/drivers/thermal/thermal_helpers.c
index 096b2210505276f4731a5e25c6e00a68b9b49ef8..ab3252385a7a87627a91532d22eb9f2ce415cdba 100644
--- a/drivers/thermal/thermal_helpers.c
+++ b/drivers/thermal/thermal_helpers.c
@@ -192,9 +192,64 @@ void thermal_zone_set_trips(struct thermal_zone_device *tz)
 	mutex_unlock(&tz->lock);
 }
 
+/*
+ * KURUMI_TIRO_PERFORMANCE_THERMAL_GUARD
+ *
+ * Preserve thermal sensing and critical/emergency protection while preventing
+ * ordinary software cooling devices from reducing interactive CPU, GPU or
+ * display performance. Matching uses stable cooling-device type names rather
+ * than registration-order IDs.
+ */
+bool kurumi_tiro_performance_cdev(
+	const struct thermal_cooling_device *cdev)
+{
+	const char *type;
+
+	if (!IS_ENABLED(CONFIG_KURUMI_TIRO_PERFORMANCE_GUARD))
+		return false;
+
+	if (!cdev)
+		return false;
+
+	type = cdev->type;
+	if (!type)
+		return false;
+
+	if (!strncmp(type, "cpufreq-", sizeof("cpufreq-") - 1) ||
+	    !strncmp(type, "thermal-cpufreq-",
+		     sizeof("thermal-cpufreq-") - 1) ||
+	    !strncmp(type, "cpu-hotplug", sizeof("cpu-hotplug") - 1) ||
+	    !strncmp(type, "cpu-isolate", sizeof("cpu-isolate") - 1) ||
+	    !strncmp(type, "pause-cpu", sizeof("pause-cpu") - 1) ||
+	    !strncmp(type, "thermal-pause-",
+		     sizeof("thermal-pause-") - 1) ||
+	    !strncmp(type, "cpu-cluster", sizeof("cpu-cluster") - 1) ||
+	    !strncmp(type, "thermal-cluster-",
+		     sizeof("thermal-cluster-") - 1))
+		return true;
+
+	if (!strcmp(type, "gpu") || !strcmp(type, "display-fps"))
+		return true;
+
+	/*
+	 * Only block KGSL GPU devfreq cooling. DDR, UFS and other devfreq
+	 * thermal clients continue to operate normally.
+	 */
+	if ((!strncmp(type, "devfreq-", sizeof("devfreq-") - 1) ||
+	     !strncmp(type, "thermal-devfreq-",
+		      sizeof("thermal-devfreq-") - 1)) &&
+	    strstr(type, "kgsl"))
+		return true;
+
+	return false;
+}
+
 static void thermal_cdev_set_cur_state(struct thermal_cooling_device *cdev,
 				       int target)
 {
+	if (kurumi_tiro_performance_cdev(cdev))
+		target = 0;
+
 	if (cdev->ops->set_cur_state(cdev, target))
 		return;
 
