index bcb81cb5642e29e0e582aea2bcc9db744f316b9c..62faa0bb65e2e0c22d068539f2805742cef76c87 100644
--- a/drivers/cpufreq/cpufreq.c
+++ b/drivers/cpufreq/cpufreq.c
@@ -749,7 +749,29 @@ static ssize_t store_##file_name					\
 	return ret >= 0 ? count : ret;					\
 }
 
-store_one(scaling_min_freq, min);
+/*
+ * KURUMI_TIRO_CPU_BASE_MIN_GUARD
+ *
+ * Keep only the base scaling_min_freq sysfs QoS request at the real hardware
+ * minimum. WALT, scheduler, input and performance clients use independent
+ * freq_qos requests and can still raise the effective minimum temporarily.
+ */
+static ssize_t store_scaling_min_freq(struct cpufreq_policy *policy,
+				      const char *buf, size_t count)
+{
+	unsigned long value;
+	int ret;
+
+	ret = sscanf(buf, "%lu", &value);
+	if (ret != 1)
+		return -EINVAL;
+
+	if (IS_ENABLED(CONFIG_KURUMI_TIRO_PERFORMANCE_GUARD))
+		value = policy->cpuinfo.min_freq;
+
+	ret = freq_qos_update_request(policy->min_freq_req, value);
+	return ret >= 0 ? count : ret;
+}
