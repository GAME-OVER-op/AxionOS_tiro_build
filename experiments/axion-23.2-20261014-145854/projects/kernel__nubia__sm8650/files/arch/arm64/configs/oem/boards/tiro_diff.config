## configs for NX769J project
#ADD:CONFIG_*

CONFIG_ZTE_BOARD_NAME="tiro"

#nubia hw version
CONFIG_NUBIA_HW_CONFIG_BY_GPIO=y

#add for charger skin thermal distinguish
CONFIG_ZTE_FEATURE_CHG_BATT_2S=y

# === Kurumi Tiro ROM kernel configuration ===
CONFIG_KURUMI_TIRO_PERFORMANCE_GUARD=y

# CONFIG_BLK_WBT is not set
# CONFIG_PER_VMA_LOCK_STATS is not set
CONFIG_SCSI_SCAN_ASYNC=y

CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_RCU_LAZY=y
# CONFIG_RCU_LAZY_DEFAULT_OFF is not set

# CONFIG_PM_DEBUG is not set
# CONFIG_PM_ADVANCED_DEBUG is not set
# CONFIG_THERMAL_STATISTICS is not set
# CONFIG_THERMAL_EMULATION is not set
# CONFIG_UBSAN is not set

# KASAN remains enabled for Qualcomm GKI/KMI compatibility.
# === End Kurumi Tiro ROM kernel configuration ===
