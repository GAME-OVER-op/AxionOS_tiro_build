# SPDX-License-Identifier: Apache-2.0
on post-fs-data
    mkdir /data/system/nubia_triggers 0770 system system
    restorecon_recursive /data/system/nubia_triggers

service nubia_trigger_service /system_ext/bin/nubia_trigger_service
    class late_start
    user system
    group system input uhid
    restart_period 5
