on post-fs-data
    mkdir /data/system/nubia_fan 0770 system system
    restorecon_recursive /data/system/nubia_fan

service nubia_fan_service /system_ext/bin/nubia_fan_service
    class late_start
    user system
    group system
    restart_period 5
