on post-fs-data
    mkdir /data/system/nubia_lighting 0770 system system
    restorecon_recursive /data/system/nubia_lighting

service nubia_lighting_service /system_ext/bin/nubia_lighting_service
    class late_start
    user system
    group system
    restart_period 5
