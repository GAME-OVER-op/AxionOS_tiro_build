cc_binary {
    name: "nubia_lighting_service",
    srcs: ["main.cpp"],
    system_ext_specific: true,
    init_rc: ["nubia_lighting_service.rc"],
    shared_libs: ["liblog"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    cpp_std: "c++17",
}
